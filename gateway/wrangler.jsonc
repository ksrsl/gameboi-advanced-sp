{
  "$schema": "../sync-worker/node_modules/wrangler/config-schema.json",
  "name": "gameboi-ksr",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-08-01",
  "services": [
    {
      "binding": "LEADERBOARD",
      "service": "ksr-gameboi-leaderboard"
    },
    {
      "binding": "RELAY",
      "service": "ksr-gameboi-relay"
    }
  ]
}
